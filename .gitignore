__pycache__/
*.pyc

# Generated packages and media must not live in the repository tree.
# Publish installable ZIPs as GitHub Release assets instead.
*.zip
*.zip.sha256
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Large generated image/output folders are external artifacts, not source code.
downloads/
assets/featured/
release/
.tmp/
tmp/
*.log
.DS_Store

# Local generated previews from Arena/image tools
outputs/

# One-off delivery/source bundles are published as GitHub Release assets, not kept in git.
docs/articles/
docs/assets/
tools/importers/

# WordPress exports and duplicate root media/packages are delivery artifacts.
/WordPress.*.xml
/logo.webp

# temporary image staging (never commit)
image-search/
.stage*/

# php-wasm runtime for tests (installed locally, never committed)
tools/phpwasm/node_modules/
tools/phpwasm/package-lock.json

# Google Drive downloads used for audits (never committed)
google_drive/

# پوشهٔ موقتِ ممیزیِ لینک‌سازی (job.json) — هرگز commit نمی‌شود
tools/sa-tests/.tmp-*/
