        "status": "active"
      },
      "travel_route": {
        "pattern": "/route/{route-slug}",
        "status": "active"
      },
      "accommodation": {
        "pattern": "/accommodation/{accommodation-slug}",
        "status": "reserved"
      }
    },
    "hub_pages": {
      "where_to_stay": {
        "pattern": "/city/{city-slug}/where-to-stay",
        "status": "reserved",
        "lists": "accommodation"
      }
    },
    "slug_rules": [
      "lowercase",
      "ascii",
      "hyphen-separated",
      "unique per CPT",
      "immutable after publish (change = 301 redirect)"
    ]
  },
  "seo_fields": {
    "applies_to": "all",
    "required": [
      "seo_title",
      "seo_description",
      "focus_keyword"
    ],
    "content_fields": [
      "faq_content"
    ],
    "generated_or_optional_overrides": [
      "og_title",
      "og_description",
      "breadcrumb_schema",
      "canonical_url"
    ],
    "deprecated": [
      {
        "name": "faq_schema",
        "replacement": "faq_content",
        "status": "deprecated",
        "structured_data_output": "disabled",
        "reason": "Google stopped showing FAQ rich results in Search on 2026-05-07; visible Q&A may remain."
      }
    ],
    "notes": [
      "focus_keyword is an internal editorial planning field, not a Google ranking field.",
      "Structured data must match visible page content; it does not guarantee a rich result or ranking."
    ],
    "accommodation_extra": {
      "status": "reserved",
      "rules": [
        "booking_url must be output with rel=\"sponsored nofollow\"",
        "is_sponsored = true requires a visible disclosure block"
      ]
    }
  },
  "content_rules": {
    "required_sections": [
      "Introduction",
      "Key Facts when applicable",
      "Contextual Internal Links",
      "SEO Data / search intent"
    ],
    "advisory_checks": [
      "missing_faq",
      "missing_coordinates",
      "missing_internal_links"
    ],
    "publish_blockers": [
      "missing_relation",
      "missing_seo_fields",
      "missing_featured_image",
      "missing_primary_taxonomy",
      "missing_sources",
      "missing_content_hygiene"
    ],
    "content_hygiene_checks": [
      "body_h1",
      "unresolved_editorial_placeholder",
      "empty_or_unlabelled_anchor"
    ],
    "minimums": {
      "province": {
        "faq": 3,
        "sources": 5,
        "internal_links": 5,
        "coordinates": true
      },
      "city": {
        "faq": 3,
        "sources": 5,
        "internal_links": 5,
        "coordinates": true
      },
      "attraction": {
        "faq": 3,
        "sources": 0,
        "internal_links": 3,
        "coordinates": true
      },
      "travel_route": {
        "faq": 3,
        "sources": 2,
        "internal_links": 3,
        "coordinates": false
      },
      "local_food": {
        "faq": 3,
        "sources": 2,
        "internal_links": 2,
        "coordinates": false
      },
      "souvenir": {
        "faq": 3,
        "sources": 2,
        "internal_links": 2,
        "coordinates": false
      },
      "accommodation": {
        "faq": 3,
        "sources": 2,
        "internal_links": 2,
        "coordinates": true
      }
    },
    "uncertainty_markers": [
      "[نیازمند بررسی]",
      "[منبع لازم]"
    ],
    "stale_after_days": 365,
    "accommodation_publish_blockers": {
      "status": "reserved",
      "items": [
        "missing belongs_to -> city",
        "missing accommodation_type",
        "is_sponsored = true without disclosure block",
        "booking_url present without affiliate_provider"
      ]
    }
  },
  "governance": {
    "source_of_truth": "MASTER_DATA_MODEL.md",
    "on_change": [
      "bump model.version",
      "add CHANGELOG.md entry",
      "update data-model.yaml",
      "run schema/build_json.py",
      "verify schema/build_child_config.py reproduces the tracked config without dropping active fields"
    ],
    "naming_policy": "Field and slug names are append-only — never rename or reuse; deprecate instead."
  }
}
