  "taxonomies": {
    "province_tax": {
      "status": "active",
      "terms": "31 provinces of Iran",
      "applies_to": [
        "province",
        "city",
        "attraction",
        "travel_route",
        "local_food",
        "souvenir",
        "accommodation"
      ]
    },
    "attraction_type": {
      "status": "active",
      "terms": [
        "historical",
        "cultural",
        "religious",
        "nature",
        "mountain",
        "forest",
        "desert",
        "beach",
        "island",
        "village",
        "ecotourism",
        "adventure"
      ],
      "applies_to": [
        "attraction"
      ]
    },
    "travel_season": {
      "status": "active",
      "terms": [
        "spring",
        "summer",
        "autumn",
        "winter"
      ],
      "applies_to": [
        "province",
        "city",
        "attraction",
        "travel_route"
      ]
    },
    "travel_budget": {
      "status": "active",
      "terms": [
        "economic",
        "medium",
        "luxury"
      ],
      "applies_to": [
        "travel_route",
        "accommodation"
      ]
    },
    "travel_duration": {
      "status": "active",
      "terms": [
        "one_day",
        "weekend",
        "3_to_5_days",
        "more_than_5_days"
      ],
      "applies_to": [
        "travel_route"
      ]
    },
    "accommodation_type": {
      "status": "reserved",
      "terms": [
        "hotel",
        "eco_lodge",
        "guest_house",
        "traditional_house",
        "camping"
      ],
      "applies_to": [
        "accommodation"
      ]
    }
  },
  "relation_rules": [
    {
      "id": "R1",
      "rule": "belongs_to -> city implies belongs_to -> province of that city; they must never disagree."
    },
    {
      "id": "R2",
      "rule": "related_many, near_many and belongs_to_many are stored as explicit edges (no free-text lists)."
    },
    {
      "id": "R3",
      "rule": "near_many edges carry distance_km."
    },
    {
      "id": "R4",
      "rule": "Deleting a City is blocked while any Attraction / LocalFood / Souvenir / Accommodation points to it."
    }
  ],
  "urls": {
    "entities": {
      "province": {
        "pattern": "/province/{province-slug}",
        "status": "active"
      },
      "city": {
        "pattern": "/city/{city-slug}",
        "status": "active"
      },
      "attraction": {
